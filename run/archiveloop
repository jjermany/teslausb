#!/bin/bash -eu

if [ "${BASH_SOURCE[0]}" != "$0" ]
then
  echo "${BASH_SOURCE[0]} must be executed, not sourced"
  return 1
fi

modprobe -r g_ether

export LOG_FILE=/mutable/archiveloop.log

function log () {
  echo "$( date ):" "$@" >> "$LOG_FILE"
  if [[ "$(stat --format="%s" "$LOG_FILE")" -gt 1000000 ]]
  then
    local log_file2="${LOG_FILE}.2"
    tail -n 5000 "$LOG_FILE" > "${log_file2}"
    mv "$log_file2" "$LOG_FILE"
    log "(log truncated)"
  fi
}

export CAM_MOUNT=/mnt/cam  
export MUSIC_MOUNT=/mnt/music  
export ARCHIVE_MOUNT=/mnt/archive  
export MUSIC_ARCHIVE_MOUNT=/mnt/musicarchive  

source /root/bin/envsetup.sh

if [ -z "${ARCHIVE_SERVER+x}" ]
then
  case "${ARCHIVE_SYSTEM:-none}" in
    rsync)
      export ARCHIVE_SERVER="$RSYNC_SERVER"
      ;;
    rclone)
      export ARCHIVE_SERVER="8.8.8.8"
      ;;
    none)
      export ARCHIVE_SERVER=localhost
      ;;
    *)
      log "ARCHIVE_SERVER not set"
      exit 1
      ;;
  esac
fi

function has_files_to_archive() {
  local sentrylist=/tmp/sentry_files
  (cd "$CAM_MOUNT"; find . -type f \( -path "./SavedClips/*" -o -path "./SentryClips/*" -o -path "./TeslaTrackMode/*" \) -printf '%P\n') > "$sentrylist"
  local sentry_count=$(wc -l < "$sentrylist")
  if [[ "$sentry_count" -gt 0 ]]; then
    return 0  # Files present to archive
  else
    return 1  # No files to archive
  fi
}

function has_music_to_sync() {
  if timeout 5 [ -d "$MUSIC_ARCHIVE_MOUNT" -a -d "$MUSIC_MOUNT" ]; then
    # Dry-run rsync to check if any files would be transferred or deleted
    if ! rsync -run --delete "$MUSIC_ARCHIVE_MOUNT/" "$MUSIC_MOUNT/" | grep -qE "^deleting|^>f"; then
      return 0  # No sync needed (music already up-to-date)
    else
      return 1  # Sync needed (changes detected)
    fi
  else
    return 0  # No sync needed if music archive mount is not available
  fi
}

function disconnect_usb_drives_from_host () {
  log "Disconnecting usb from host..."
  if /root/bin/disable_gadget.sh
  then
    log "USB disconnected from host."
  else
    log "Failed to disconnect usb from host."
  fi
}

function ensure_mountpoint_is_mounted () {
  local mount_point="$1"
  local mount_exists=true
  findmnt --mountpoint "$mount_point" > /dev/null || mount_exists=false
  if [ "$mount_exists" = true ]
  then
    log "$mount_point is already mounted."
    return 0
  fi
  if timeout 10 mount "$mount_point" >> "$LOG_FILE" 2>&1
  then
    log "Mounted $mount_point."
    return 0
  else
    log "Failed to mount $mount_point."
    return 1
  fi
}

function ensure_mountpoint_is_mounted_with_retry () {
  local mount_point="$1"
  local max_retries=5
  local count=0
  until ensure_mountpoint_is_mounted "$mount_point"
  do
    count=$((count+1))
    if [ $count -ge $max_retries ]
    then
      return 1
    fi
    sleep 1
  done
  return 0
}

function ensure_music_file_is_mounted () {
  log "Ensuring music drive is mounted..."
  disconnect_usb_drives_from_host
  if ensure_mountpoint_is_mounted_with_retry "$MUSIC_MOUNT"
  then
    log "Music drive is mounted."
  else
    log "Failed to mount music drive."
  fi
}

function unmount_music_file () {
  log "Unmounting music drive..."
  if umount "$MUSIC_MOUNT" >> "$LOG_FILE" 2>&1
  then
    log "Unmounted $MUSIC_MOUNT."
  else
    log "Failed to unmount $MUSIC_MOUNT, attempting lazy unmount."
    if umount -l "$MUSIC_MOUNT" >> "$LOG_FILE" 2>&1
    then
      log "Lazily unmounted $MUSIC_MOUNT."
    else
      log "Lazy unmount failed for $MUSIC_MOUNT."
    fi
  fi
}

function trim_free_space () {
  local mount_point="$1"
  if findmnt -n --mountpoint "$mount_point" > /dev/null
  then
    log "Trimming free space in $mount_point..."
    if fstrim "$mount_point" >> "$LOG_FILE" 2>&1
    then
      log "Trim complete for $mount_point."
    else
      log "Trimming free space in $mount_point failed."
    fi
  else
    log "Cannot trim free space: $mount_point is not mounted."
  fi
}

function archive_clips () {
  log "Archiving..."
  if ! /root/bin/connect-archive.sh
  then
    log "Couldn't connect archive, skipping archive step"
    /root/bin/send-push-message "$NOTIFICATION_TITLE:" "Couldn't connect to archive" error || log "Failed to send error notification"
    return
  fi

  if ! has_cam_disk
  then
    log "Skipping archiving (no cam disk)"
  elif ! has_files_to_archive
  then
    log "No new clips to archive."
  else
    /root/bin/send-push-message "$NOTIFICATION_TITLE:" "Archiving started" start || log "Failed to send start notification"
    if archive_teslacam_clips
    then
      local archived_count=$(wc -l < /tmp/sentry_files)
      log "Finished archiving. Archived $archived_count files."
      /root/bin/send-push-message "$NOTIFICATION_TITLE:" "Archiving completed: $archived_count file(s) archived." finish || log "Failed to send finish notification"
    else
      log "Archiving failed."
      /root/bin/send-push-message "$NOTIFICATION_TITLE:" "Archiving encountered errors" error || log "Failed to send error notification"
    fi
  fi

  # If no music sync is needed, disconnect the archive now (otherwise leave it mounted for music sync)
  if ! has_music_to_sync
  then
    /root/bin/disconnect-archive.sh
  fi
}

function sync_music_files () {
  if timeout 5 [ -d "$MUSIC_ARCHIVE_MOUNT" -a -d "$MUSIC_MOUNT" ]
  then
    if ! has_music_to_sync
    then
      log "Copying music..."
      ensure_music_file_is_mounted
      if /root/bin/copy-music.sh
      then
        local music_copied_count=$(grep -oP 'Number of regular files transferred: \K\d+' /tmp/rsyncmusiclog.txt || echo 0)
        log "Finished copying music. $music_copied_count file(s) copied."
        /root/bin/send-push-message "$NOTIFICATION_TITLE:" "Music copy completed: $music_copied_count file(s) copied." finish || log "Failed to send music completion notification"
        trim_free_space "$MUSIC_MOUNT"
        unmount_music_file
      else
        log "Copying music failed."
        /root/bin/send-push-message "$NOTIFICATION_TITLE:" "Music copy failed" error || log "Failed to send music error notification"
        unmount_music_file
      fi
    else
      log "No new music to sync, skipping music copy."
    fi
  else
    log "Music archive not configured or unreachable"
  fi
}

while true; do
  slowblink

  wait_for_archive_to_be_reachable
  fastblink
  set_time

  sleep "${ARCHIVE_DELAY:-20}"

  if has_files_to_archive || has_music_to_sync; then
    /root/bin/awake_start || true
    /root/bin/send-push-message "$NOTIFICATION_TITLE:" "Awake started for archiving and syncing" start || log "Failed to send awake start notification"
  fi

  # Take a snapshot of RecentClips before archiving (if CAM drive is available)
  if has_cam_disk; then
    /root/bin/make_snapshot.sh
  fi

  archive_clips
  sync_music_files

  if has_files_to_archive || has_music_to_sync; then
    /root/bin/awake_stop || true
    /root/bin/send-push-message "$NOTIFICATION_TITLE:" "Awake stopped after archiving and syncing" finish || log "Failed to send awake stop notification"
    /root/bin/disconnect-archive.sh
  fi

  doubleblink
  connect_usb_drives_to_host
  wait_for_archive_to_be_unreachable
  check_if_usb_gadget_is_mounted

done
